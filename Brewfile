# Core packages: everything the shell and Neovim config needs.
# Optional groups live in brewfiles/*.Brewfile (chosen in install.sh).
# Install with: brew bundle --file ~/dotfiles/Brewfile

# Shell
brew "zsh-autocomplete"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "starship"
brew "zoxide"
brew "fzf"

# Core CLI (aliased/used by .zshrc)
brew "bat"
brew "eza"
brew "fd"          # fast, gitignore-aware find (used by telescope and fzf Opt+C)
brew "grep"        # GNU grep, used ahead of the macOS BSD grep
brew "ripgrep"
brew "git"
brew "stow"

# Runtimes (versions in .config/mise/config.toml)
brew "mise"

# Neovim
brew "neovim"
brew "tree-sitter-cli" # builds treesitter parsers
