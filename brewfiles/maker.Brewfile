# @desc Maker tools: balenaEtcher · Bambu Studio · Raspberry Pi Imager
# @default off
# macOS-only casks (on Linux, install via your distro)
cask "balenaetcher" if OS.mac? # flash OS images to SD cards and USB drives
cask "bambu-studio" if OS.mac? # 3D printer slicer
cask "raspberry-pi-imager" if OS.mac?
