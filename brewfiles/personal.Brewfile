# @desc Personal apps: Chrome · Opera GX · Discord · Signal · Obsidian · Keeper · Proton Mail Bridge · AppCleaner
# @default off
# macOS-only casks (on Linux, install via your distro)
cask "google-chrome" if OS.mac?
cask "opera-gx" if OS.mac?
cask "discord" if OS.mac?
cask "signal" if OS.mac?
cask "obsidian" if OS.mac? # Markdown knowledge base
cask "keeper-password-manager" if OS.mac?
cask "proton-mail-bridge" if OS.mac? # Proton Mail in IMAP/SMTP clients
cask "appcleaner" if OS.mac? # uninstall apps with their leftovers
